{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/pages/about", "destination": "/about", "permanent": true },
    { "source": "/pages/classes", "destination": "/classes", "permanent": true },
    { "source": "/pages/trainers", "destination": "/trainers", "permanent": true },
    { "source": "/pages/cafe", "destination": "/cafe", "permanent": true },
    { "source": "/pages/plans", "destination": "/plans", "permanent": true }
  ],
  "rewrites": [
    { "source": "/cms", "destination": "/cms/index.html" },
    { "source": "/cms/dashboard", "destination": "/cms/dashboard.html" },
    { "source": "/favicon.ico", "destination": "/assets/logo.png" },
    { "source": "/gallery", "destination": "/gallery/index.html" },
    { "source": "/gallery/:page", "destination": "/gallery/index.html" },
    { "source": "/about", "destination": "/about.html" },
    { "source": "/classes", "destination": "/classes.html" },
    { "source": "/trainers", "destination": "/trainers.html" },
    { "source": "/cafe", "destination": "/cafe.html" },
    { "source": "/plans", "destination": "/plans.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    }
  ]
}
